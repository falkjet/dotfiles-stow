;; vim:syntax=kanata:ts=6:sw=0

(defcfg
	process-unmapped-keys yes
	delegate-to-first-layer yes
	linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd)

(defsrc esc
	grv	1	2	3	4	5	6	7	8	9	0	=
	tab	q	w	e	r	t	y	u	i	o	p
	caps	a	s	d	f	g	h	j	k	l	;	'	ret
	lsft	102d	z	x	c	v	b	n	m	,	.	/
	lctl	lmet	lalt			spc			ralt	rmet)

(defalias
	] (tap-dance-eager 200 (] (macro bspc (unicode ⟧))))
	[ (tap-dance-eager 200 ([ (macro bspc (unicode ⟦))))
	⟩ (tap-dance-eager 200 ((unicode ⟩) (macro bspc (unicode ⟫))))
	⟨ (tap-dance-eager 200 ((unicode ⟨) (macro bspc (unicode ⟪))))
	caps (caps-word-toggle 1000))

(defalias
	a (tap-hold-release 200 200 a lmet)
	s (tap-hold-release 200 200 s lalt)
	d (tap-hold-release 200 200 d lctl)
	f (tap-hold-release 200 200 f lsft)
	x (tap-hold-release 200 200 x (layer-while-held symbols))
	c (tap-hold-release 200 200 c (layer-while-held navigation))
	w (tap-hold-release 200 200 w (layer-while-held workspaces))

	j (tap-hold-release 200 200 j lsft)
	k (tap-hold-release 200 200 k lctl)
	l (tap-hold-release 200 200 l lalt)
	; (tap-hold-release 200 200 ; lmet)
	. (tap-hold-release 200 200 . (layer-while-held symbols))

	qtyz (tap-hold-release 200 200 z (layer-while-held symbols))
	qtyx (tap-hold-release 200 200 x (layer-while-held navigation))
	
	colr (tap-hold-release 200 200 r lalt)
	cols (tap-hold-release 200 200 s lctl)
	colt (tap-hold-release 200 200 t lsft)

	coln (tap-hold-release 200 200 n lsft)
	cole (tap-hold-release 200 200 e lctl)
	coli (tap-hold-release 200 200 i lalt)
	colo (tap-hold-release 200 200 o lmet)

	
	strs (tap-hold-release 200 200 s lmet)
	strt (tap-hold-release 200 200 t lalt)
	strr (tap-hold-release 200 200 r lctl)
	strd (tap-hold-release 200 200 d lsft)
	strn (tap-hold-release 200 200 n lsft)
	stra (tap-hold-release 200 200 a lctl)
	stre (tap-hold-release 200 200 e lalt)
	stri (tap-hold-release 200 200 i lmet)
	strk (tap-hold-release 200 200 k (layer-while-held symbols))
	strq (tap-hold-release 200 200 q (layer-while-held navigation))
	str: (tap-hold-release 200 200 S-; (layer-while-held symbols))
	
	fcs (tap-hold-release 200 200 s lmet)
	fcr (tap-hold-release 200 200 r lalt)
	fcn (tap-hold-release 200 200 n lctl)
	fct (tap-hold-release 200 200 t lsft)
	fcx (tap-hold-release 200 200 x (layer-while-held symbols))
	fcm (tap-hold-release 200 200 m (layer-while-held navigation))
	fcl (tap-hold-release 200 200 l (layer-while-held workspaces))

	fcc (tap-hold-release 200 200 c lsft)
	fca (tap-hold-release 200 200 a lctl)
	fce (tap-hold-release 200 200 e lalt)
	fci (tap-hold-release 200 200 i lmet)
	fc; (tap-hold-release 200 200 S-; (layer-while-held symbols))

	low (layer-while-held lower)
	game (layer-switch gaming)
	stur (layer-switch base-sturdy)
	col (layer-switch base-colemak)
	fc (layer-switch base-focal)
	qw (layer-switch base-qwerty)
	chat (multi t (layer-switch chat))
	fcty (layer-switch typing-focal)

	smo (fork (unicode ‘) (unicode “) (lsft))
	smc (fork (unicode ’) (unicode ”) (lsft))

	m (switch
	     ((key-history 3 1)) (macro i n c l u d e)  break
	     ((key-history p 1)) t break
	     ((key-history c 1)) y break
	     ((key-history d 1)) g break))

(deflayer base-focal esc
	grv	1	2	3	4	5	6	7	8	9	0	=
	tab	v	@fcl	h	g	k	q	f	o	u	j
	@caps	@fcs	@fcr	@fcn	@fct	b	y	@fcc	@fca	@fce	@fci	ret	ret
	z	z	@x	@fcm	d	p	@m	@smc	w	.	@fc;	,
	@low	lmet	bspc			spc			ralt	rmet)


(deflayer typing-focal (layer-switch base-focal)
	grv	1	2	3	4	5	6	7	8	9	0	=
	tab	v	@fcl	h	g	k	q	f	o	u	j
	@caps	s	r	n	t	b	y	c	a	e	i	ret	ret
	z	z	x	m	d	p	@smo	@smc	w	.	@fc;	,
	@low	lmet	bspc			spc			ralt	rmet)

(deflayer base-qwerty esc
	grv	1	2	3	4	5	6	7	8	9	0	=
	tab	q	@w	e	r	t	y	u	i	o	p
	bspc	@a	@s	@d	@f	g	h	@j	@k	@l	@;	ret	ret
	lsft	102d	@qtyz	@qtyx	c	v	b	n	m	,	@.	/
	@low	lmet	bspc			spc			ralt	rmet)


(deflayer base-colemak esc
	grv	1	2	3	4	5	6	7	8	9	0	=
	tab	q	@w	f	p	g	j	l	u	y	;
	bspc	@a	@colr	@cols	@colt	d	h	@coln	@cole	@coli	@colo	ret	ret
	z	z	@x	@c	v	b	S--	k	m	,	@.	/
	@low	lmet	bspc			spc			ralt	rmet)

(deflayer base-sturdy esc
	grv	1	2	3	4	5	6	7	8	9	0	=
	tab	v	m	l	c	p	x	f	o	u	j
	bspc	@strs	@strt	@strr	@strd	y	.	@strn	@stra	@stre	@stri	ret	ret
	z	z	@strk	@strq	g	w	S--	b	h	'	@str:	,
	@low	lmet	bspc			spc			ralt	rmet)

(deflayer lower esc
	_	_	_	_	_	_	_	_	_	_	_	_
	_	@qw	_	_	lrld	@fcty	_	_	_	_	_
	_	_	@stur	_	@fc	@game	_	_	_	_	_	_	_
	_	_	_	_	@col	_	_	_	_	_	_	_
	_	_	_			_			_	_)

(deflayer symbols _
	grv	_	_	_	_	_	_	_	@⟨	@⟩	_	=
	tab	S-1	S-8	=	S-4	S-=	S-5	S-[	S-]	S-'	'
	lctl	S-,	S-\	-	S-.	S-2	S-3	S-9	S-0	;	S-;	ret	_
	lsft	S-/	S-`	/	\	S-7	S-1	S--	@[	@]	=	`
	lrld	lmet	bspc			spc			ralt	rmet)

(deflayer navigation _
	_	_	_	_	_	_	_	_	_	_	_	=
	tab	_	_	_	_	_	_	_	_	_	_
	bspc	@a	@s	@d	@f	g	left	down	up	right	@;	ret	_
	_	_	@x	@c	_	_	_	_	_	,	@.	/
	lrld	lmet	bspc			spc			ralt	rmet)

(deflayer workspaces _
	_	_	_	_	_	_	_	_	_	_	_	_
	_	_	_	_	_	_	_	M-7	M-8	M-9	_
	_	_	_	_	_	_	_	M-4	M-5	M-6	_	_	_
	_	_	_	_	_	_	_	_	M-1	M-2	M-3	_
	_	_	_			_			_	_)

(deflayer gaming esc
	_	_	_	_	_	_	_	_	_	_	_	_
	tab	q	w	e	r	@chat	y	u	i	o	p
	caps	a	s	d	f	g	h	j	k	l	;	'	_
	lsft	102d	z	x	c	v	b	n	m	,	.	/
	lctl	lmet	lalt			spc			(layer-switch base-focal)	rmet)

(deflayer chat (multi esc (layer-switch gaming))
	_	_	_	_	_	_	_	_	_	_	_	_
	_	_	_	_	_	_	_	_	_	_	_
	_	_	_	_	_	_	_	_	_	_	_	(multi ret (layer-switch gaming) ret) (multi ret (layer-switch gaming) ret)
	_	_	_	_	_	_	_	_	_	_	_	_
	_	_	_			_			_	_)

